{
  "version": 3,
  "id": "scenario-set-passenger-offers-002",
  "name": "Passenger Multi-Offer Dialogue and Selection Scenario",
  "description": "Декларативная спецификация диалога сравнения предложений, ответов на информационные вопросы и выбора оффера пассажиром",
  "scenarios": [
    {
      "id": "sc-compare-eta",
      "intent": "compare_offers",
      "triggerPhrases": [
        "кто приедет быстрее",
        "какая машина ближе",
        "самый быстрый вариант",
        "кто быстрее"
      ],
      "query": {
        "attribute": "etaMinutes",
        "mode": "min"
      },
      "responseTemplate": "Быстрее всего {{index}}-й вариант — приедет через {{etaMinutes}} мин."
    },
    {
      "id": "sc-compare-price",
      "intent": "compare_offers",
      "triggerPhrases": [
        "какой дешевле",
        "самый дешёвый вариант",
        "кто дешевле",
        "какая машина дешевле"
      ],
      "query": {
        "attribute": "price",
        "mode": "min"
      },
      "responseTemplate": "Дешевле всего {{index}}-й вариант — {{price}} руб."
    },
    {
      "id": "sc-select-passenger-offer",
      "intent": "select_offer",
      "triggerPhrases": [
        "тогда давайте второй",
        "выбираю второй вариант",
        "поеду на втором",
        "беру первый",
        "давайте первый",
        "давайте третий",
        "выбираю комфорт",
        "поеду на комфорте",
        "да"
      ],
      "slotExtractors": {
        "confirmation": {
          "type": "enum",
          "values": ["да", "согласен", "подтверждаю", "беру", "поеду"],
          "patterns": ["\\b(да|согласен|подтверждаю|беру|поеду)\\b"]
        },
        "targetOfferIndex": {
          "type": "integer",
          "rules": [
            { "pattern": "\\bперв(ый|ого|ому|ом)\\b|\\b1\\b", "value": 1 },
            { "pattern": "\\bвтор(ой|ого|ому|ом)\\b|\\b2\\b", "value": 2 },
            { "pattern": "\\bтрет(ий|ьего|ьему|ьем)\\b|\\b3\\b", "value": 3 },
            { "pattern": "\\bчетверт(ый|ого|ому|ом)\\b|\\b4\\b", "value": 4 }
          ]
        },
        "targetVehicleType": {
          "type": "string",
          "rules": [
            { "pattern": "\\b(комфорт|комфорта|комфорте)\\b", "value": "comfort" },
            { "pattern": "\\b(эконом|эконома|экономе|стандарт)\\b", "value": "standard" },
            { "pattern": "\\b(бизнес|бизнеса|бизнесе)\\b", "value": "business" }
          ]
        },
        "ambiguousSelectionCriteria": {
          "type": "string",
          "rules": [
            { "pattern": "\\b(быстр(ый|ее)|ближ(е|айший))\\b", "value": "fastest" },
            { "pattern": "\\b(дешев(ый|ле)|экономн(ый|ее))\\b", "value": "cheapest" }
          ]
        }
      },
      "action": "ASSIGN_SELECTED_OFFER",
      "responseTemplate": "Вы выбрали {{index}}-й вариант ({{vehicleType}}). Машина прибудет через {{etaMinutes}} мин."
    }
  ]
}
