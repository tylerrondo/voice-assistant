{
  "version": 1,
  "id": "scenario-set-passenger-offers-002",
  "name": "Passenger Multi-Offer Dialogue and Selection Scenario",
  "description": "Declarative comparison, information queries, and selection of passenger offers.",
  "scenarios": [
    {
      "id": "sc-compare-fastest",
      "name": "Вопрос о самом быстром предложении",
      "activation": {
        "type": "voice",
        "value": "voice.compare-fastest"
      },
      "aliases": [
        "какой быстрее",
        "кто быстрее",
        "быстрее всего",
        "самый быстрый"
      ],
      "priority": 100,
      "intent": "COMPARE_OFFERS_ETA",
      "evaluation": {
        "kind": "compare",
        "attribute": "etaMinutes",
        "order": "min",
        "responseTemplate": "Самый быстрый вариант — {{index}}."
      },
      "candidateBinding": {
        "idField": "offerId",
        "indexField": "index",
        "statusField": "status",
        "unavailableValue": "UNAVAILABLE"
      },
      "steps": [
        {
          "kind": "end"
        }
      ]
    },
    {
      "id": "sc-compare-cheapest",
      "name": "Вопрос о самом дешевом предложении",
      "activation": {
        "type": "voice",
        "value": "voice.compare-cheapest"
      },
      "aliases": [
        "какой дешевле",
        "кто дешевле",
        "дешевле всего",
        "самый дешевый",
        "самый дешёвый"
      ],
      "priority": 100,
      "intent": "COMPARE_OFFERS_PRICE",
      "evaluation": {
        "kind": "compare",
        "attribute": "price",
        "order": "min",
        "responseTemplate": "Самый дешёвый вариант — {{index}}."
      },
      "candidateBinding": {
        "idField": "offerId",
        "indexField": "index",
        "statusField": "status",
        "unavailableValue": "UNAVAILABLE"
      },
      "steps": [
        {
          "kind": "end"
        }
      ]
    },
    {
      "id": "sc-query-offer-comfort",
      "name": "Вопрос о типе автомобиля второго оффера",
      "activation": {
        "type": "voice",
        "value": "voice.query-offer-comfort"
      },
      "aliases": [
        "а второй это комфорт",
        "второй комфорт",
        "вторая машина комфорт"
      ],
      "priority": 100,
      "intent": "QUERY_OFFER_COMFORT",
      "evaluation": {
        "kind": "query_attribute",
        "attribute": "vehicleType",
        "targetIndex": 2,
        "responseTemplate": "Тип автомобиля: {{vehicleType}}."
      },
      "candidateBinding": {
        "idField": "offerId",
        "indexField": "index",
        "statusField": "status",
        "unavailableValue": "UNAVAILABLE"
      },
      "steps": [
        {
          "kind": "end"
        }
      ]
    },
    {
      "id": "sc-query-offer-distance",
      "name": "Вопрос о расстоянии до машины",
      "activation": {
        "type": "voice",
        "value": "voice.query-offer-distance"
      },
      "aliases": [
        "а далеко находится второй водитель",
        "далеко второй",
        "где второй"
      ],
      "priority": 101,
      "intent": "QUERY_OFFER_DISTANCE",
      "evaluation": {
        "kind": "query_attribute",
        "attribute": "distanceKm",
        "targetIndex": 2,
        "responseTemplate": "Расстояние до водителя: {{distanceKm}} км."
      },
      "candidateBinding": {
        "idField": "offerId",
        "indexField": "index",
        "statusField": "status",
        "unavailableValue": "UNAVAILABLE"
      },
      "steps": [
        {
          "kind": "end"
        }
      ]
    },
    {
      "id": "sc-select-passenger-offer",
      "name": "Выбор конкретного предложения и подтверждение",
      "activation": {
        "type": "voice",
        "value": "voice.select-offer"
      },
      "aliases": [
        "тогда давайте",
        "давайте",
        "выбираю",
        "выбрать",
        "хочу"
      ],
      "priority": 90,
      "intent": "SELECT_OFFER",
      "requiredSlots": [
        "selectedOfferId",
        "confirmation"
      ],
      "candidateBinding": {
        "targetSlot": "selectedOfferId",
        "idField": "offerId",
        "labelField": "driver",
        "indexField": "index",
        "statusField": "status",
        "unavailableValue": "UNAVAILABLE",
        "unavailableTemplate": "Предложение {{targetId}} больше недоступно.",
        "ambiguityTriggerValues": [
          "cheapest",
          "fastest"
        ]
      },
      "slotExtractors": {
        "candidate_index": {
          "type": "integer",
          "rules": [
            {
              "pattern": "\\b(первый|первую|первое|первым|вариант\\s*1)\\b",
              "value": 1
            },
            {
              "pattern": "\\b(второй|вторую|второе|вторым|вариант\\s*2)\\b",
              "value": 2
            },
            {
              "pattern": "\\b(третий|третью|третье|третьим|вариант\\s*3)\\b",
              "value": 3
            }
          ]
        },
        "candidate_criteria": {
          "type": "string",
          "rules": [
            {
              "pattern": "\\b(подешевле|дешевле)\\b",
              "value": "cheapest"
            },
            {
              "pattern": "\\b(побыстрее|быстрее)\\b",
              "value": "fastest"
            }
          ]
        },
        "confirmation": {
          "type": "enum",
          "rules": [
            {
              "pattern": "^\\s*(да(?:,\\s*подтверждаю)?|подтверждаю|давай|заказывай|поехали)\\s*[.!?]*$",
              "value": "CONFIRMED"
            },
            {
              "pattern": "^\\s*(нет|не надо|отбой)\\s*[.!?]*$",
              "value": "REJECTED"
            }
          ]
        }
      },
      "clarificationPrompts": {
        "selectedOfferId": "Какой из предложенных вариантов вы хотите выбрать?",
        "confirmation": "Подтвердить выбор предложения?"
      },
      "ambiguityPrompt": {
        "template": "Есть несколько подходящих вариантов. Выберите, пожалуйста: первый, второй или третий?"
      },
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "passenger.offer.selected",
            "payload": {
              "orderId": 5001,
              "offerId": "{{slots.selectedOfferId}}"
            }
          }
        },
        {
          "kind": "end"
        }
      ]
    }
  ]
}
