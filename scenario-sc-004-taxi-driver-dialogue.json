{
  "version": 2,
  "id": "scenario-set-sc-004-taxi-driver-dialogue",
  "name": "Taxi Driver Multi-Turn Dialogue & Slot-Filling Workflow",
  "description": "Многошаговый голосовой сценарий водителя такси с дозапросом номера заказа (orderId) через Dialogue State и переводом рабочего FSM в ORDER_ACCEPTED.",
  "scenarios": [
    {
      "id": "sc004-accept-order-dialogue",
      "name": "Принятие заказа с уточнением номера",
      "activation": {
        "type": "voice",
        "value": "voice.accept-order"
      },
      "intent": "ACCEPT_ORDER",
      "requiredSlots": [
        "orderId"
      ],
      "clarificationPrompts": {
        "orderId": "Какой заказ?"
      },
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "driver.order.accepted",
            "payload": {
              "orderId": "{{slots.orderId}}"
            }
          }
        },
        {
          "kind": "end"
        }
      ],
      "triggerPhrases": [
        "прими заказ",
        "принять заказ",
        "заказ"
      ],
      "slotExtractors": {
        "orderId": {
          "type": "integer",
          "pattern": "\\b\\d+\\b"
        }
      }
    },
    {
      "id": "sc004-accept-order-dialogue-driver-arrived",
      "name": "Independent command: driver arrived",
      "intent": "DRIVER_ARRIVED",
      "triggerPhrases": [
        "я приехал",
        "я приехала",
        "я на месте",
        "на месте"
      ],
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "driver.arrived",
            "payload": {
              "orderId": 1001
            }
          }
        },
        {
          "kind": "end"
        }
      ]
    }
  ]
}
