{
  "version": 1,
  "id": "scenario-set-nanny",
  "name": "Nanny Booking Dialogue",
  "scenarios": [
    {
      "id": "order-nanny",
      "intent": "ORDER_NANNY",
      "triggerPhrases": [
        "нужна няня",
        "заказать няню",
        "поиск няни",
        "order nanny"
      ],
      "requiredSlots": [
        "date",
        "start_time",
        "end_time",
        "children_count",
        "children_ages",
        "location",
        "requirements",
        "selected_nanny",
        "confirmation"
      ],
      "candidateBinding": {
        "targetSlot": "selected_nanny",
        "idField": "id",
        "labelField": "name",
        "indexField": "index",
        "statusField": "status",
        "unavailableValue": "UNAVAILABLE",
        "unavailableTemplate": "Няня {{targetId}} сейчас недоступна"
      },
      "confirmation": {
        "slot": "confirmation",
        "confirmedValue": "CONFIRMED",
        "rejectedValue": "REJECTED",
        "confirmLabel": "Да",
        "rejectLabel": "Отмена",
        "confirmedMessage": "Заказ подтверждён.",
        "cancelledMessage": "Диалог отменён."
      },
      "clarificationPrompts": {
        "date": "Когда нужна няня?",
        "start_time": "Во сколько нужно начать?",
        "end_time": "До скольки нужна няня?",
        "children_count": "Сколько детей?",
        "children_ages": "Какой возраст детей?",
        "location": "Укажите адрес или район",
        "requirements": "Есть ли особые пожелания или требования?",
        "selected_nanny": "Какую няню вы выбираете?",
        "confirmation": "Подтверждаете заказ?"
      },
      "slotExtractors": {
        "date": {
          "type": "string",
          "rules": [
            { "pattern": "(сегодня|today)", "value": "сегодня" },
            { "pattern": "(завтра|tomorrow)", "value": "завтра" },
            { "pattern": "(послезавтра)", "value": "послезавтра" }
          ]
        },
        "start_time": {
          "type": "string",
          "rules": [
            { "pattern": "(с\\s+четырех|в\\s+четыре|в\\s+16(:00)?|16:00)", "value": "16:00" },
            { "pattern": "(с\\s+трех|в\\s+три|в\\s+15(:00)?|15:00)", "value": "15:00" },
            { "pattern": "(с\\s+десяти|в\\s+10(:00)?|10:00)", "value": "10:00" },
            { "pattern": "(с\\s+девяти|в\\s+9(:00)?|09:00)", "value": "09:00" }
          ]
        },
        "end_time": {
          "type": "string",
          "rules": [
            { "pattern": "(до\\s+восьми|до\\s+20(:00)?|20:00)", "value": "20:00" },
            { "pattern": "(до\\s+шести|до\\s+18(:00)?|18:00)", "value": "18:00" },
            { "pattern": "(до\\s+пяти|до\\s+17(:00)?|17:00)", "value": "17:00" }
          ]
        },
        "children_count": {
          "type": "integer",
          "rules": [
            { "pattern": "(на\\s+одного|один|1)", "value": 1 },
            { "pattern": "(на\\s+двух|двое|двух|2)", "value": 2 },
            { "pattern": "(на\\s+трех|трое|трех|3)", "value": 3 }
          ]
        },
        "children_ages": {
          "type": "string",
          "rules": [
            { "pattern": "(3\\s+и\\s+5|3,\\s*5)", "value": "3 и 5 лет" },
            { "pattern": "(5\\s+лет|пять\\s+лет)", "value": "5 лет" },
            { "pattern": "(любой|не\\s+важно)", "value": "не указан" }
          ]
        },
        "location": {
          "type": "string",
          "rules": [
            { "pattern": "(центр|центральный\\s+район)", "value": "Центр" },
            { "pattern": "(ленина\\s*10|ул\\.?\\s*ленина)", "value": "ул. Ленина 10" }
          ]
        },
        "requirements": {
          "type": "string",
          "rules": [
            { "pattern": "(без\\s+вредных\\s+привычек|педагогическое\\s+образование)", "value": "педагогическое образование" },
            { "pattern": "(нет|без\\s+требований|стандартные)", "value": "без особых требований" }
          ]
        },
        "candidate_index": {
          "type": "integer",
          "rules": [
            { "pattern": "(перв(ая|ую|ый)|вариант\\s+1)", "value": 1 },
            { "pattern": "(втор(ая|ую|ой)|вариант\\s+2)", "value": 2 }
          ]
        },
        "candidate_name": {
          "type": "string",
          "rules": [
            { "pattern": "(мари[яю]|maria)", "value": "Мария" },
            { "pattern": "(анн[ау]|anna)", "value": "Анна" },
            { "pattern": "(ирин[ау]|irina)", "value": "Ирина" },
            { "pattern": "(ольг[ау]|olga)", "value": "Ольга" }
          ]
        },
        "confirmation": {
          "type": "enum",
          "rules": [
            { "pattern": "(да|подтверждаю|да,\\s*подтверждаю|верно|confirm)", "value": "CONFIRMED" },
            { "pattern": "(отмена|отменяю|отменить|отбой|reject|cancel|нет,\\s*отмена)", "value": "REJECTED" }
          ]
        }
      },
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "nanny.order.confirmed",
            "payload": {}
          }
        }
      ]
    }
  ]
}
