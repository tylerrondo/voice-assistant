{
  "version": 2,
  "id": "scenario-set-sc-007-taxi-driver-context-isolation",
  "name": "Taxi Driver Context Isolation Workflow",
  "description": "Сценарий проверки строгой изоляции контекста при переключении между несколькими заказами без смешивания slots и actions.",
  "scenarios": [
    {
      "id": "sc007-accept-order-isolation",
      "name": "Принятие заказа с изолированным Dialogue State",
      "activation": {
        "type": "voice",
        "value": "voice.accept-order"
      },
      "intent": "ACCEPT_ORDER",
      "requiredSlots": [
        "orderId",
        "payment"
      ],
      "clarificationPrompts": {
        "orderId": "Какой заказ?",
        "payment": "Какой способ оплаты?"
      },
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "driver.order.accepted",
            "payload": {
              "orderId": "{{slots.orderId}}",
              "payment": "{{slots.payment}}"
            }
          }
        },
        {
          "kind": "end"
        }
      ],
      "aliases": [
        "Принять заказ",
        "Прими заказ",
        "Беру заказ",
        "Accept order"
      ],
      "slotExtractors": {
        "orderId": {
          "type": "integer",
          "pattern": "\\b\\d+\\b"
        },
        "payment": {
          "type": "enum",
          "mapping": {
            "card": [
              "картой",
              "карта",
              "безнал",
              "card"
            ],
            "cash": [
              "наличными",
              "наличка",
              "наличными деньгами",
              "cash"
            ]
          }
        }
      }
    },
    {
      "id": "sc007-driver-arrived",
      "name": "Подтверждение прибытия к заказу для проверки переключения контекста",
      "activation": {
        "type": "voice",
        "value": "voice.driver-arrived"
      },
      "intent": "DRIVER_ARRIVED",
      "requiredSlots": [
        "orderId"
      ],
      "clarificationPrompts": {
        "orderId": "К какому заказу вы приехали?"
      },
      "steps": [
        {
          "kind": "emit",
          "event": {
            "type": "driver.arrived",
            "payload": {
              "orderId": "{{slots.orderId}}"
            }
          }
        },
        {
          "kind": "end"
        }
      ],
      "aliases": [
        "Я приехал",
        "Прибыл",
        "На месте"
      ],
      "slotExtractors": {
        "orderId": {
          "type": "integer",
          "pattern": "\\b\\d+\\b"
        }
      }
    }
  ]
}
